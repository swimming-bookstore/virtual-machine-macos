#cloud-config
hostname: debian
users:
  - name: debian
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: users, admin
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: debian
ssh_pwauth: true
chpasswd:
  expire: false
package_update: true
package_upgrade: false
package_reboot_if_required: false
packages:
  - openssh-server
  - task-xfce-desktop
  - fonts-noto-cjk
write_files:
  - path: /etc/firefox-esr/policies/policies.json
    permissions: "0644"
    content: |
      {
        "policies": {
          "3rdparty": {
            "Extensions": {
              "uBlock0@raymondhill.net": {
                "toOverwrite": {
                  "trustedSiteDirectives": [
                    "youtube.com",
                    "www.youtube.com",
                    "youtu.be",
                    "googlevideo.com",
                    "ytimg.com"
                  ]
                }
              }
            }
          }
        }
      }
runcmd:
  - systemctl enable --now ssh
  - systemctl set-default graphical.target
  - systemctl isolate graphical.target
