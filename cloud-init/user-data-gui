#cloud-config
hostname: debian
users:
  - name: debian
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: users, admin
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: debian
ssh_pwauth: true
chpasswd:
  expire: false
package_update: true
package_upgrade: false
package_reboot_if_required: false
packages:
  - openssh-server
  - task-gnome-desktop
runcmd:
  - systemctl enable --now ssh
  - systemctl set-default graphical.target
